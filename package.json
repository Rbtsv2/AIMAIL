{
  "name": "aimail",
  "productName": "AIMAIL",
  "version": "0.2.0",
  "description": "Client mail orienté IA",
  "main": "./out/main/index.js",
  "author": "Charles Fournier",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings scripts/dev.ts",
    "dev:raw": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/postinstall.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "build:win": "bash scripts/build-win.sh",
    "build:mac": "bash scripts/build-mac.sh",
    "build:linux": "bash scripts/build-linux.sh",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:linux:ci": "electron-vite build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@tiptap/extension-image": "^2.11.0",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "better-sqlite3": "^11.7.0",
    "dompurify": "^3.2.3",
    "electron-updater": "^6.8.11",
    "framer-motion": "^11.15.0",
    "html-to-text": "^9.0.5",
    "imapflow": "^1.0.171",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.7.2",
    "mammoth": "^1.8.0",
    "nodemailer": "^6.9.16",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/dompurify": "^3.2.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
